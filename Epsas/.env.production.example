APP_NAME="EPSAS El Portillo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_URL=https://epsas-el-portillo.example.com
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
ENFORCE_HTTPS=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=epsas_production
DB_USERNAME=epsas_app
DB_PASSWORD=
DB_PERSISTENT=false
PRODUCTION_DATABASE_NAME=epsas_production

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_STORE=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=__Host-epsas-session
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PERSISTENT=true
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE=default

MAIL_FROM_ADDRESS=soporte@epsas-el-portillo.example.com
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

SMS_DRIVER=log
SMS_DEFAULT_COUNTRY_CODE=+591

BANK_WEBHOOK_PROVIDER=
BANK_WEBHOOK_SECRET=
BANK_WEBHOOK_TOLERANCE_SECONDS=300
BANK_WEBHOOK_EMPLOYEE_ID=
LUKA_CHECKOUT_URL=https://checkout.lukabolivia.com
LUKA_MERCHANT_ID=

PRODUCTION_MONITORING_ENABLED=true
MONITORING_HEALTH_TOKEN=
EXTERNAL_MONITOR_CONFIGURED=true
MONITORING_QUEUE_BACKLOG_LIMIT=100
MONITORING_MINIMUM_FREE_DISK_MB=1024
SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=5
BACKUP_VERIFICATION_MAX_AGE_DAYS=90

RETENTION_PERSONAL_PHOTO_DAYS=365
RETENTION_TECHNICAL_EVIDENCE_DAYS=730
RETENTION_APPROVED_PAYMENT_PROOF_DAYS=3650
RETENTION_REJECTED_PAYMENT_PROOF_DAYS=365

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
