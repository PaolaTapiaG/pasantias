APP_NAME="EPSAS El Portillo"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
ENFORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=epsas
DB_USERNAME=epsas
DB_PASSWORD=change-this-local-password
DB_PERSISTENT=false
DB_SSLMODE=disable

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_STORE=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE=default
REDIS_PERSISTENT=true

SMS_DRIVER=log
BANK_WEBHOOK_PROVIDER=
BANK_WEBHOOK_SECRET=
LUKA_MERCHANT_ID=
PRODUCTION_MONITORING_ENABLED=false
EXTERNAL_MONITOR_CONFIGURED=false
VITE_APP_NAME="${APP_NAME}"
