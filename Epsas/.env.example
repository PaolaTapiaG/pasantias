APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_URL=http://localhost
APP_TIMEZONE=America/La_Paz
ENABLE_LOGIN_WARMUP=false
PRODUCTION_MONITORING_ENABLED=false
MONITORING_HEALTH_TOKEN=
EXTERNAL_MONITOR_CONFIGURED=false
MONITORING_QUEUE_BACKLOG_LIMIT=100
MONITORING_MINIMUM_FREE_DISK_MB=1024
SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=5
BACKUP_VERIFICATION_MAX_AGE_DAYS=90
PRODUCTION_DATABASE_NAME=
ENFORCE_HTTPS=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
LOCAL_DB_WAKEUP_ENABLED=false
LOCAL_DB_WAKEUP_INTERVAL_SECONDS=120

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=epsas
DB_USERNAME=epsas_app
DB_PASSWORD=
